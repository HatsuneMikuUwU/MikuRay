<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/bottom_sheet"
    android:orientation="vertical"
    android:background="?colorBg"
    android:paddingBottom="8.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginStart="0.0dip"
        android:layout_marginEnd="0.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:layout_marginBottom="5.0dip"
                android:layout_marginStart="16.0dip"
                android:layout_marginEnd="16.0dip"
                app:cardBackgroundColor="?colorCard"
                app:cardCornerRadius="28.0dip"
                app:cardElevation="0.0dip"
                app:strokeWidth="0.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="fill_parent"
                        android:layout_height="150.0dip"
                        android:layout_marginTop="12.0dip"
                        android:layout_marginBottom="12.0dip"
                        android:layout_marginStart="12.0dip"
                        android:layout_marginEnd="12.0dip"
                        app:cardBackgroundColor="#00000000"
                        app:cardCornerRadius="19.0dip"
                        app:cardElevation="0.0dip"
                        app:strokeWidth="0.0dip">
                        <ImageView
                            android:id="@+id/img_banner_sheet"
                            android:layout_width="fill_parent"
                            android:layout_height="150.0dip"
                            android:src="@drawable/uwu_banner_sheet"
                            android:scaleType="centerCrop"
                            android:elevation="0.0dip" />
                        <View
                            android:id="@+id/view_banner_sheet_dim"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent" />
                        <com.miku.ray.particlesdrawable.ParticlesView
                            android:id="@+id/ParticlesView"
                            android:background="#00000000"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_centerInParent="true"
                            app:particleColor="?colorPrimary"
                            app:frameDelayMillis="10"
                            app:lineColor="?colorPrimary"
                            app:lineLength="86.0dip"
                            app:lineThickness="1.0dip"
                            app:particleRadiusMax="4.0dip"
                            app:particleRadiusMin="1.0dip"
                            app:density="60"
                            app:speedFactor="1.0" />
                        <LinearLayout
                            android:gravity="bottom"
                            android:layout_gravity="bottom"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:clipToPadding="false"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:gravity="center"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16.0dip"
                                    android:layout_marginBottom="16.0dip"
                                    android:layout_marginStart="16.0dip"
                                    android:layout_marginEnd="5.0dip">
                                    <com.miku.ray.widget.ProfileBannerImageView
                                        android:layout_width="60.0dip"
                                        android:layout_height="60.0dip"
                                        android:src="@drawable/uwu_banner_profile"
                                        app:siBorderColor="?colorPrimary"
                                        app:siBorderWidth="3.0dip" />
                                </LinearLayout>
                                <RelativeLayout
                                    android:paddingTop="16.0dip"
                                    android:paddingBottom="16.0dip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.0"
                                    android:layout_marginStart="5.0dip"
                                    android:layout_marginEnd="5.0dip">
                                    <LinearLayout
                                        android:orientation="vertical"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content">
                                        <com.miku.ray.marquee.text.UserNameTextView
                                            android:textAppearance="?textAppearanceTitleMedium"
                                            android:textStyle="bold"
                                            android:textSize="17.0sp"
                                            android:textColor="?colorOnSurface"
                                            android:ellipsize="marquee"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:singleLine="true"
                                            android:marqueeRepeatLimit="marquee_forever" />
                                        <com.miku.ray.marquee.text.RandomText
                                            android:textAppearance="?textAppearanceTitleSmall"
                                            android:textStyle="bold"
                                            android:textSize="14.0sp"
                                            android:textColor="?colorOnSurfaceVariant"
                                            android:ellipsize="marquee"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:singleLine="true"
                                            android:marqueeRepeatLimit="marquee_forever"
                                            uwu_runnable="false" />
                                    </LinearLayout>
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="24.0dip"
                android:paddingTop="5.0dip"
                android:paddingRight="24.0dip"
                android:paddingBottom="5.0dip"
                android:paddingHorizontal="24.0dip"
                android:gravity="center_vertical">

                <com.miku.ray.widget.UwuHeaderIconView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:sectionIcon="@drawable/rmx_file_line"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:textAppearance="?textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="?colorPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_item_add_asset" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/add_file"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5.0dip"
                android:layout_marginBottom="4.0dip"
                android:layout_marginStart="16.0dip"
                android:layout_marginEnd="16.0dip"
                android:focusable="true"
                android:clickable="true"
                app:cardBackgroundColor="?colorCard"
                app:cardElevation="0.0dip"
                app:strokeWidth="0.0dip"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CardView.Top"
                app:cardPreventCornerOverlap="false"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipToPadding="false"
                    android:baselineAligned="false"
                    android:minHeight="?android:listPreferredItemHeightSmall">

                    <LinearLayout
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip"
                        android:layout_marginBottom="16.0dip"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="8.0dip">
                        <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8.0dip">
                                <com.miku.ray.widget.DynamicShapeImageView
                                    app:shapeTarget="icon"
                                    app:shapeBackgroundColor="?colorPrimary"
                                    android:layout_width="45.0dip"
                                    android:layout_height="45.0dip"
                                    android:scaleType="centerCrop" />
                                <ImageView
                                    android:layout_gravity="center"
                                    android:layout_width="25.0dip"
                                    android:layout_height="25.0dip"
                                    android:src="@drawable/rmx_file_line"
                                    android:tint="?colorOnPrimary" />
                            </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:layout_marginBottom="20.0dip"
                        android:layout_weight="1.0"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="16.0dip">
                        <TextView
                            android:textAppearance="?textAppearanceTitleMedium"
                            android:textSize="17.0sp"
                            android:textColor="?colorOnSurface"
                            android:ellipsize="marquee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_item_add_file"
                            android:singleLine="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip"
                        android:layout_marginBottom="16.0dip"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="16.0dip">
                        <FrameLayout
                            android:layout_width="28.0dip"
                            android:layout_height="28.0dip">

                            <com.miku.ray.widget.DynamicShapeImageView
                                app:shapeTarget="arrow"
                                app:shapeBackgroundColor="?colorSurfaceContainerHighest"
                                android:layout_width="28.0dip"
                                android:layout_height="28.0dip"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="24.0dip"
                                android:layout_height="24.0dip"
                                android:src="@drawable/rmx_arrows_arrow_right_double_line"
                                android:tint="?colorOnSurfaceVariant" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/add_url"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.0dip"
                android:layout_marginBottom="4.0dip"
                android:layout_marginStart="16.0dip"
                android:layout_marginEnd="16.0dip"
                android:focusable="true"
                android:clickable="true"
                app:cardBackgroundColor="?colorCard"
                app:cardElevation="0.0dip"
                app:strokeWidth="0.0dip"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CardView.Middle"
                app:cardPreventCornerOverlap="false"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipToPadding="false"
                    android:baselineAligned="false"
                    android:minHeight="?android:listPreferredItemHeightSmall">

                    <LinearLayout
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip"
                        android:layout_marginBottom="16.0dip"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="8.0dip">
                        <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8.0dip">
                                <com.miku.ray.widget.DynamicShapeImageView
                                    app:shapeTarget="icon"
                                    app:shapeBackgroundColor="?colorPrimary"
                                    android:layout_width="45.0dip"
                                    android:layout_height="45.0dip"
                                    android:scaleType="centerCrop" />
                                <ImageView
                                    android:layout_gravity="center"
                                    android:layout_width="25.0dip"
                                    android:layout_height="25.0dip"
                                    android:src="@drawable/rmx_edit_line"
                                    android:tint="?colorOnPrimary" />
                            </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:layout_marginBottom="20.0dip"
                        android:layout_weight="1.0"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="16.0dip">
                        <TextView
                            android:textAppearance="?textAppearanceTitleMedium"
                            android:textSize="17.0sp"
                            android:textColor="?colorOnSurface"
                            android:ellipsize="marquee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_item_add_url"
                            android:singleLine="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip"
                        android:layout_marginBottom="16.0dip"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="16.0dip">
                        <FrameLayout
                            android:layout_width="28.0dip"
                            android:layout_height="28.0dip">

                            <com.miku.ray.widget.DynamicShapeImageView
                                app:shapeTarget="arrow"
                                app:shapeBackgroundColor="?colorSurfaceContainerHighest"
                                android:layout_width="28.0dip"
                                android:layout_height="28.0dip"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="24.0dip"
                                android:layout_height="24.0dip"
                                android:src="@drawable/rmx_arrows_arrow_right_double_line"
                                android:tint="?colorOnSurfaceVariant" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/add_qrcode"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.0dip"
                android:layout_marginBottom="8.0dip"
                android:layout_marginStart="16.0dip"
                android:layout_marginEnd="16.0dip"
                android:focusable="true"
                android:clickable="true"
                app:cardBackgroundColor="?colorCard"
                app:cardElevation="0.0dip"
                app:strokeWidth="0.0dip"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CardView.Bottom"
                app:cardPreventCornerOverlap="false"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipToPadding="false"
                    android:baselineAligned="false"
                    android:minHeight="?android:listPreferredItemHeightSmall">

                    <LinearLayout
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip"
                        android:layout_marginBottom="16.0dip"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="8.0dip">
                        <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8.0dip">
                                <com.miku.ray.widget.DynamicShapeImageView
                                    app:shapeTarget="icon"
                                    app:shapeBackgroundColor="?colorPrimary"
                                    android:layout_width="45.0dip"
                                    android:layout_height="45.0dip"
                                    android:scaleType="centerCrop" />
                                <ImageView
                                    android:layout_gravity="center"
                                    android:layout_width="25.0dip"
                                    android:layout_height="25.0dip"
                                    android:src="@drawable/rmx_qr_code_line"
                                    android:tint="?colorOnPrimary" />
                            </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:layout_marginBottom="20.0dip"
                        android:layout_weight="1.0"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="16.0dip">
                        <TextView
                            android:textAppearance="?textAppearanceTitleMedium"
                            android:textSize="17.0sp"
                            android:textColor="?colorOnSurface"
                            android:ellipsize="marquee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/menu_item_scan_qrcode"
                            android:singleLine="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.0dip"
                        android:layout_marginBottom="16.0dip"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="16.0dip">
                        <FrameLayout
                            android:layout_width="28.0dip"
                            android:layout_height="28.0dip">

                            <com.miku.ray.widget.DynamicShapeImageView
                                app:shapeTarget="arrow"
                                app:shapeBackgroundColor="?colorSurfaceContainerHighest"
                                android:layout_width="28.0dip"
                                android:layout_height="28.0dip"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="24.0dip"
                                android:layout_height="24.0dip"
                                android:src="@drawable/rmx_arrows_arrow_right_double_line"
                                android:tint="?colorOnSurfaceVariant" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
