<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.neko.widget.UwuPreferenceCategory
        android:key="pref_category_vpn_settings"
        android:title="@string/title_vpn_settings"
        app:sectionIcon="@drawable/rmx_node_tree">

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_toggle_line"
            app:layout="@layout/uwu_top_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:key="pref_ipv6_enabled"
            android:summary="@string/summary_pref_ipv6_enabled"
            android:title="@string/title_pref_ipv6_enabled" />

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_system_eye_line"
            app:layout="@layout/uwu_mid_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:defaultValue="false"
            android:key="pref_keep_awake"
            android:summary="@string/summary_pref_keep_awake"
            android:title="@string/title_pref_keep_awake" />

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_global_line"
            app:layout="@layout/uwu_mid_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:key="pref_prefer_ipv6"
            android:summary="@string/summary_pref_prefer_ipv6"
            android:title="@string/title_pref_prefer_ipv6" />

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_server_line"
            app:layout="@layout/uwu_mid_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:key="pref_local_dns_enabled"
            android:summary="@string/summary_pref_local_dns_enabled"
            android:title="@string/title_pref_local_dns_enabled" />

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_server_line"
            app:layout="@layout/uwu_mid_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:key="pref_fake_dns_enabled"
            android:summary="@string/summary_pref_fake_dns_enabled"
            android:title="@string/title_pref_fake_dns_enabled" />

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_global_line"
            app:layout="@layout/uwu_mid_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:key="pref_append_http_proxy"
            android:summary="@string/summary_pref_append_http_proxy"
            android:title="@string/title_pref_append_http_proxy" />

        <EditTextPreference
            android:icon="@drawable/rmx_server_line"
            app:dialogIcon="@drawable/rmx_server_line"
            app:layout="@layout/uwu_mid"
            android:key="pref_vpn_dns"
            android:summary="@string/summary_pref_remote_dns"
            android:title="@string/title_pref_vpn_dns"
            android:dialogMessage="@string/title_pref_vpn_dns_tip" />

        <ListPreference
            android:icon="@drawable/rmx_node_tree"
            app:dialogIcon="@drawable/rmx_node_tree"
            app:layout="@layout/uwu_mid"
            android:defaultValue="1"
            android:entries="@array/vpn_bypass_lan"
            android:entryValues="@array/vpn_bypass_lan_value"
            android:key="pref_vpn_bypass_lan"
            android:summary="%s"
            android:title="@string/title_pref_vpn_bypass_lan" />

        <ListPreference
            android:icon="@drawable/rmx_wifi_line"
            app:dialogIcon="@drawable/rmx_wifi_line"
            app:layout="@layout/uwu_mid"
            android:defaultValue="0"
            android:entries="@array/vpn_interface_address"
            android:entryValues="@array/vpn_interface_address_value"
            android:key="pref_vpn_interface_address_config_index"
            android:summary="%s"
            android:title="@string/title_pref_vpn_interface_address" />

        <EditTextPreference
            android:icon="@drawable/rmx_design_ruler_line"
            app:dialogIcon="@drawable/rmx_design_ruler_line"
            app:layout="@layout/uwu_mid"
            android:inputType="number"
            android:key="pref_vpn_mtu"
            android:summary="1500"
            android:title="@string/title_pref_vpn_mtu"
            android:dialogMessage="@string/title_pref_vpn_mtu_tip" />

        <EditTextPreference
            android:icon="@drawable/rmx_time_line"
            app:dialogIcon="@drawable/rmx_time_line"
            app:layout="@layout/uwu_mid"
            android:inputType="number"
            android:key="pref_tcp_keepalive_idle"
            android:defaultValue="30"
            android:title="@string/title_pref_tcp_keepalive_idle"
            android:dialogMessage="@string/title_pref_tcp_keepalive_idle_tip" />

        <EditTextPreference
            android:icon="@drawable/rmx_time_line"
            app:dialogIcon="@drawable/rmx_time_line"
            app:layout="@layout/uwu_mid"
            android:inputType="number"
            android:key="pref_ws_heartbeat_period"
            android:defaultValue="60"
            android:title="@string/title_pref_ws_heartbeat_period"
            android:dialogMessage="@string/title_pref_ws_heartbeat_period_tip" />

        <Preference
            android:icon="@drawable/rmx_apps_line"
            app:layout="@layout/uwu_bot"
            android:key="pref_navigate_per_app_proxy_settings"
            android:summary="@string/summary_navigate_per_app_proxy_settings"
            android:title="@string/per_app_proxy_settings" />

    </com.neko.widget.UwuPreferenceCategory>

    <com.neko.widget.UwuPreferenceCategory
        android:key="pref_category_hev_tunnel"
        android:title="@string/title_category_hev_tunnel"
        app:sectionIcon="@drawable/rmx_global_line">

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_toggle_line"
            app:layout="@layout/uwu_top_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:defaultValue="true"
            android:key="pref_use_hev_tunnel_v2"
            android:summary="@string/summary_pref_use_hev_tunnel"
            android:title="@string/title_pref_use_hev_tunnel" />

        <ListPreference
            android:icon="@drawable/rmx_global_line"
            app:dialogIcon="@drawable/rmx_global_line"
            app:layout="@layout/uwu_mid"
            android:defaultValue="off"
            android:entries="@array/hev_tunnel_icmp"
            android:entryValues="@array/hev_tunnel_icmp"
            android:key="pref_hev_tunnel_icmp"
            android:summary="@string/summary_pref_hev_tunnel_icmp"
            android:title="@string/title_pref_hev_tunnel_icmp" />

        <ListPreference
            android:icon="@drawable/rmx_global_line"
            app:dialogIcon="@drawable/rmx_global_line"
            app:layout="@layout/uwu_mid"
            android:defaultValue="udp"
            android:entries="@array/hev_tunnel_udp_mode"
            android:entryValues="@array/hev_tunnel_udp_mode"
            android:key="pref_hev_tunnel_udp_mode"
            android:summary="@string/summary_pref_hev_tunnel_udp_mode"
            android:title="@string/title_pref_hev_tunnel_udp_mode" />

        <EditTextPreference
            android:icon="@drawable/rmx_global_line"
            app:dialogIcon="@drawable/rmx_global_line"
            app:layout="@layout/uwu_mid"
            android:key="pref_hev_tunnel_udp_address"
            android:title="@string/title_pref_hev_tunnel_udp_address"
            android:dialogMessage="@string/title_pref_hev_tunnel_udp_address_tip" />

        <ListPreference
            android:icon="@drawable/rmx_file_text_line"
            app:dialogIcon="@drawable/rmx_file_text_line"
            app:layout="@layout/uwu_mid"
            android:defaultValue="warn"
            android:entries="@array/hev_tunnel_loglevel"
            android:entryValues="@array/hev_tunnel_loglevel"
            android:key="pref_hev_tunnel_loglevel"
            android:summary="%s"
            android:title="@string/title_pref_hev_tunnel_loglevel" />

        <EditTextPreference
            android:icon="@drawable/rmx_time_line"
            app:dialogIcon="@drawable/rmx_time_line"
            app:layout="@layout/uwu_mid"
            android:key="pref_hev_tunnel_rw_timeout_v2"
            android:summary="300,60"
            android:title="@string/title_pref_hev_tunnel_rw_timeout"
            android:dialogMessage="@string/title_pref_hev_tunnel_rw_timeout_tip" />

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_flashlight_line"
            app:layout="@layout/uwu_mid_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:defaultValue="true"
            android:key="pref_hev_tunnel_tcp_fastopen"
            android:summary="@string/summary_pref_hev_tunnel_tcp_fastopen"
            android:title="@string/title_pref_hev_tunnel_tcp_fastopen" />

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_development_git_merge_line"
            app:layout="@layout/uwu_bot_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:defaultValue="false"
            android:key="pref_hev_tunnel_pipeline"
            android:summary="@string/summary_pref_hev_tunnel_pipeline"
            android:title="@string/title_pref_hev_tunnel_pipeline" />

    </com.neko.widget.UwuPreferenceCategory>

    <com.neko.widget.UwuPreferenceCategory
        android:key="pref_category_root_mode"
        android:title="@string/title_category_root_mode">

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_key_line"
            app:layout="@layout/uwu_top_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:key="pref_root_mode_enabled"
            android:title="@string/title_pref_root_mode"
            android:summary="@string/summary_pref_root_mode"
            android:defaultValue="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:icon="@drawable/rmx_share_line"
            app:layout="@layout/uwu_bot_switch"
            app:widgetLayout="@layout/uwu_widget_material_switch"
            android:key="pref_root_lan_sharing"
            android:title="@string/title_pref_root_lan_sharing"
            android:summary="@string/summary_pref_root_lan_sharing"
            android:defaultValue="false" />

    </com.neko.widget.UwuPreferenceCategory>

</PreferenceScreen>
